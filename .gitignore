# Dependencies (root only - do not use a bare "node_modules/" pattern,
# it would also hide test/fixtures/sample-repo/node_modules, which exists
# on purpose to test the scanner's exclusion logic)
/node_modules/

# Build output
/dist/

# Environment & secrets
.env
.env.*

# Logs
*.log
npm-debug.log*

# Test/coverage output
/coverage/

# OS junk
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Generated by running this tool against itself (npm run demo / npm run generate)
/CONTEXT.md
/.github/copilot-instructions.md

# Generated static dashboard output (npm run dashboard)
/dashboard.html
