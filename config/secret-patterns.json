{
  "name": "secret-patterns",
  "version": "1",
  "description": "Line-pattern and file-path patterns used by the repo-scanner to redact or exclude secret-like content before it reaches any LLM call. Reviewable/versioned independently of code.",
  "linePatterns": [
    { "name": "generic-api-key", "pattern": "(api[_-]?key|apikey)\\s*[:=]\\s*['\"]?[A-Za-z0-9_\\-\\/+=]{8,}" },
    { "name": "generic-secret", "pattern": "(secret|client[_-]?secret)\\s*[:=]\\s*['\"]?[A-Za-z0-9_\\-\\/+=]{8,}" },
    { "name": "password", "pattern": "(password|passwd|pwd)\\s*[:=]\\s*['\"]?\\S{4,}" },
    { "name": "private-key-header", "pattern": "-----BEGIN( RSA| EC| OPENSSH| DSA)? PRIVATE KEY-----" },
    { "name": "aws-access-key", "pattern": "AKIA[0-9A-Z]{16}" },
    { "name": "generic-token", "pattern": "(token|bearer)\\s*[:=]\\s*['\"]?[A-Za-z0-9_\\-\\.]{10,}" },
    { "name": "connection-string-credential", "pattern": "(mongodb|postgres|mysql|redis):\\/\\/[^:]+:[^@]+@" }
  ],
  "excludedFileGlobs": [
    ".env",
    ".env.*",
    "*.pem",
    "*.key",
    "*.pfx",
    "*.p12",
    "id_rsa",
    "id_rsa.pub",
    "id_ed25519",
    "**/secrets/**",
    "**/*secret*credential*"
  ]
}
